---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Category } from '../data/categories';
import { ROUTES } from '../config/paths';

interface Props {
  category: Category;
}

const { category } = Astro.props;
const categoryUrl = `${ROUTES.DESTINATIONS}?category=${category.slug}`;

// Use import.meta.glob to dynamically load optimized images from assets
const images = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/images/placeholders/**/*.{jpeg,jpg,png,webp,avif}'
);

// Map public path to asset path
const assetPath = `/src/assets${category.image}`;
const imageLoader = images[assetPath];
---

<a
  href={categoryUrl}
  class="group relative block aspect-[4/5] w-full overflow-hidden rounded-[var(--radius-lg)] bg-[var(--card-bg)] shadow-md transition-all duration-200 ease-out hover:shadow-xl hover:-translate-y-1"
>
  {
    imageLoader ? (
      <Image
        src={imageLoader()}
        alt=""
        width={400}
        height={500}
        class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-110"
        loading="lazy"
        decoding="async"
      />
    ) : (
      <img
        src={category.image}
        alt=""
        class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-110"
        loading="lazy"
        decoding="async"
      />
    )
  }
  <div
    class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/40 to-transparent transition-opacity group-hover:via-black/50"
  >
  </div>

  <div class="absolute bottom-0 left-0 p-6 w-full">
    <div
      class="mb-2 flex items-center justify-center w-10 h-10 rounded-full bg-white/20 backdrop-blur-md text-white border border-white/30"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="1.5"
        stroke="currentColor"
        class="w-5 h-5"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d={category.icon}></path>
      </svg>
    </div>
    <h3
      class="text-xl font-bold text-white mb-1 group-hover:text-[var(--color-secondary)] transition-colors"
    >
      {category.name}
    </h3>
    <span
      class="inline-block text-sm font-medium text-white/80 bg-black/30 px-2 py-0.5 rounded-full"
    >
      {category.count} Destinations
    </span>
  </div>
</a>
