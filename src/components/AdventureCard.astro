---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Adventure } from '../data/adventures';
import { ROUTES } from '../config/paths';

interface Props {
  adventure: Adventure;
}

const { adventure } = Astro.props;
const adventureUrl = ROUTES.BLOG_DETAIL(adventure.slug);

// Use import.meta.glob to dynamically load optimized images from assets
const images = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/images/placeholders/**/*.{jpeg,jpg,png,webp,avif}'
);

// Map public path to asset path
const assetPath = `/src/assets${adventure.image}`;
const imageLoader = images[assetPath];
---

<a
  href={adventureUrl}
  class="group flex flex-col h-full overflow-hidden rounded-[var(--radius-lg)] bg-[var(--card-bg)] border border-[var(--border-subtle)] hover:shadow-xl hover:-translate-y-1 transition-all duration-200 ease-out"
>
  <div class="relative aspect-video overflow-hidden">
    {
      imageLoader ? (
        <Image
          src={imageLoader()}
          alt={adventure.imageAlt}
          width={600}
          height={338}
          class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
          loading="lazy"
          decoding="async"
        />
      ) : (
        <img
          src={adventure.image}
          alt={adventure.imageAlt}
          class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
          loading="lazy"
          decoding="async"
        />
      )
    }
    <div class="absolute top-3 right-3 flex flex-wrap gap-1 justify-end">
      {
        adventure.categories.map((category) => (
          <span class="inline-block rounded-full bg-white/90 px-2 py-1 text-xs font-bold text-[var(--text-primary)] shadow-sm backdrop-blur-sm dark:bg-black/80 dark:text-white">
            {category}
          </span>
        ))
      }
    </div>
  </div>
  <div class="flex flex-1 flex-col p-5">
    <div class="mb-2 flex items-center gap-2 text-xs text-[var(--text-secondary)]">
      <span>{adventure.date}</span>
      <span>•</span>
      <span>{adventure.readTime}</span>
    </div>
    <h3
      class="mb-2 text-lg font-bold text-[var(--text-primary)] leading-tight group-hover:text-[var(--color-primary)] transition-colors"
    >
      {adventure.title}
    </h3>
    <p class="mb-4 text-sm text-[var(--text-secondary)] line-clamp-2 flex-1">
      {adventure.excerpt}
    </p>
    <div class="mt-auto flex items-center justify-between">
      <div class="flex items-center gap-2">
        {
          images[`/src/assets${adventure.author.image}`] ? (
            <Image
              src={images[`/src/assets${adventure.author.image}`]()}
              alt={adventure.author.name}
              width={24}
              height={24}
              class="w-6 h-6 rounded-full object-cover border border-[var(--border-subtle)]"
            />
          ) : (
            <img
              src={adventure.author.image}
              alt={adventure.author.name}
              class="w-6 h-6 rounded-full object-cover border border-[var(--border-subtle)]"
            />
          )
        }
        <span class="text-xs font-medium text-[var(--text-secondary)]">{adventure.author.name}</span
        >
      </div>
      <span class="text-sm font-semibold text-[var(--color-primary)] group-hover:underline">
        Read Story →
      </span>
    </div>
  </div>
</a>
