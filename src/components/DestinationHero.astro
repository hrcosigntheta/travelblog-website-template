---
import type { Destination } from '../data/destinations';

interface Props {
  destination: Destination;
}

const { destination } = Astro.props;

const stats = [
  {
    label: 'Best Time',
    value: destination.stats.bestTime,
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>`,
    colorClass: 'text-blue-400 bg-blue-900/30',
  },
  {
    label: 'Budget',
    value: destination.stats.budget,
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>`,
    colorClass: 'text-green-400 bg-green-900/30',
  },
  {
    label: 'Difficulty',
    value: destination.stats.difficulty,
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6.5 6.5l11 11M21 21l-1-1M3 3l1 1M21 3l-1 1M3 21l1-1M17 7v10M7 7v10"></path></svg>`,
    colorClass: 'text-orange-400 bg-orange-900/30',
  },
];
---

<section class="relative h-[80vh] min-h-[600px] flex items-center justify-center overflow-hidden">
  {/* Background Image */}
  <div class="absolute inset-0 z-0">
    <img
      src={destination.image}
      alt={destination.title}
      class="w-full h-full object-cover"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-black/30 via-black/40 to-black/80"></div>
  </div>

  {/* Content */}
  <div class="relative z-10 container mx-auto px-4 text-center text-white">
    {/* Breadcrumb / Region */}
    <div
      class="mb-4 flex items-center justify-center gap-2 text-sm md:text-base font-medium uppercase tracking-wider text-white/80 animate-fade-in-up"
    >
      <span class="opacity-70">Destinations</span>
      <span class="opacity-50">•</span>
      <span class="text-[var(--color-primary-light)]">{destination.region}</span>
    </div>

    {/* Title */}
    <h1
      class="font-display text-5xl md:text-7xl font-bold mb-8 drop-shadow-xl tracking-tight animate-fade-in-up delay-100"
    >
      {destination.title}
    </h1>

    {/* Stats Grid */}
    <div class="flex flex-wrap justify-center gap-4 md:gap-8 mb-10 animate-fade-in-up delay-200">
      {
        stats.map((stat) => (
          <div class="flex items-center gap-3 bg-black/40 backdrop-blur-sm px-4 py-2 rounded-full border border-white/10">
            <div class={`p-1.5 rounded-full ${stat.colorClass}`} set:html={stat.icon} />
            <div class="text-left">
              <span class="block text-xs font-bold text-white/60 uppercase tracking-wide">
                {stat.label}
              </span>
              <span class="font-medium text-white">{stat.value}</span>
            </div>
          </div>
        ))
      }
    </div>

    {/* Social Sharing */}
    <div class="flex justify-center gap-4 animate-fade-in-up delay-300">
      <button
        data-share="facebook"
        data-url={`https://example.com/destinations/${destination.slug}`}
        aria-label="Share on Facebook"
        class="p-3 bg-white/10 hover:bg-white/20 backdrop-blur-sm rounded-full transition-colors border border-white/10 text-white"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg
        >
      </button>
      <button
        data-share="twitter"
        data-url={`https://example.com/destinations/${destination.slug}`}
        aria-label="Share on Twitter"
        class="p-3 bg-white/10 hover:bg-white/20 backdrop-blur-sm rounded-full transition-colors border border-white/10 text-white"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><path
            d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-12.7 12.5S.2 5.3 4.1 2c-.3 2 .5 3.2 1.8 4.2C2.4 6.3 3 5.8 3 4c.1 2.5 1.8 4.9 4 5.6C5.3 10 3 10 3 10c1.5 2.4 4 3 6 3 0 0-2 0-3.7-.6 5 2.5 8 1 8 1s-.5-2.2-2-3c1.7 0 2.2.5 2.5 1-.2-1-.7-2-1-2z"
          ></path></svg
        >
      </button>
      <button
        data-share="pinterest"
        data-url={`https://example.com/destinations/${destination.slug}`}
        aria-label="Share on Pinterest"
        class="p-3 bg-white/10 hover:bg-white/20 backdrop-blur-sm rounded-full transition-colors border border-white/10 text-white"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"
          ></line></svg
        >
      </button>
      <button
        data-share="copy"
        data-url={`https://example.com/destinations/${destination.slug}`}
        aria-label="Copy Link"
        class="p-3 bg-white/10 hover:bg-white/20 backdrop-blur-sm rounded-full transition-colors border border-white/10 text-white"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path
            d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg
        >
      </button>
    </div>
  </div>
</section>

<style>
  .delay-100 {
    animation-delay: 100ms;
  }
  .delay-200 {
    animation-delay: 200ms;
  }
  .delay-300 {
    animation-delay: 300ms;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in-up {
    animation: fadeInUp 0.8s ease-out forwards;
    opacity: 0;
  }
</style>

<script>
  import { openDemoModal } from '../store/demo-modal';

  const shareButtons = document.querySelectorAll('[data-share]');

  shareButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const type = button.getAttribute('data-share');
      const url = button.getAttribute('data-url');

      let label = 'Social Media';
      if (type === 'facebook') label = 'Facebook Share';
      if (type === 'twitter') label = 'Twitter Share';
      if (type === 'pinterest') label = 'Pinterest Share';
      if (type === 'copy') label = 'Copy Link';

      openDemoModal({
        url: url || window.location.href,
        label,
        category: 'social',
      });
    });
  });
</script>
