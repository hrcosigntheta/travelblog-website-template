---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ContactForm } from '../components/ContactForm';
import { SocialLinksSection } from '../components/SocialLinksSection';
import { FAQAccordion } from '../components/FAQAccordion';
import { ImageWithFallback } from '../components/ImageWithFallback';
import { CONTACT_FAQS } from '../data/faqs';
import Breadcrumb from '../components/Breadcrumb.astro';
import { bloggerProfile } from '../data/blogger';
import { ROUTES } from '../config/paths';
import { getAssetPath } from '../utils/paths';

const title = `Contact | Philippine Travel Blog`;
const description =
  'Get in touch with us for collaborations, questions, or just to say hello. We love hearing from fellow travelers!';

const schema = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ContactPage',
      name: title,
      description: description,
      url: new URL(ROUTES.CONTACT, Astro.site),
      mainEntity: {
        '@type': 'Person',
        name: bloggerProfile.name,
        image: new URL(bloggerProfile.portraitSrc, Astro.site),
        jobTitle: 'Travel Blogger',
        url: new URL(ROUTES.ABOUT, Astro.site),
        sameAs: bloggerProfile.socialLinks.map((link) => link.url),
      },
    },
    {
      '@type': 'FAQPage',
      mainEntity: CONTACT_FAQS.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: faq.answer,
        },
      })),
    },
  ],
});
---

<BaseLayout title={title} description={description} schema={schema}>
  <div class="container mx-auto px-4 pt-4">
    <Breadcrumb items={[{ label: 'Contact', href: ROUTES.CONTACT }]} />
  </div>
  {/* Hero Section */}
  <section class="relative h-[40vh] min-h-[400px] flex items-center justify-center overflow-hidden">
    <div class="absolute inset-0 z-0">
      <ImageWithFallback
        src={getAssetPath('/images/placeholders/people/people-1.jpg')}
        alt="Person typing on laptop"
        className="w-full h-full object-cover"
        loading="eager"
        client:load
      />
      <div
        class="absolute inset-0 bg-gradient-to-t from-[var(--bg-default)] via-black/40 to-black/20"
      >
      </div>
    </div>
    <div class="relative z-10 text-center px-4 max-w-4xl mx-auto">
      <h1
        class="text-4xl md:text-5xl lg:text-6xl font-display font-bold text-white mb-6 drop-shadow-lg"
      >
        Get in Touch
      </h1>
      <p
        class="text-lg md:text-xl text-white/90 max-w-2xl mx-auto font-light leading-relaxed drop-shadow-md"
      >
        Have a question about a destination? Want to work together? Or just want to share your own
        travel story? We'd love to hear from you.
      </p>
    </div>
  </section>

  <div class="container mx-auto px-4 py-12 md:py-20">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16">
      {/* Contact Form Column */}
      <div class="lg:col-span-7">
        <h2 class="text-3xl font-display font-bold text-[var(--text-primary)] mb-8">
          Send us a Message
        </h2>
        <div
          class="bg-[var(--bg-surface)] rounded-[var(--radius-xl)] p-6 md:p-8 shadow-sm border border-[var(--border-subtle)]"
        >
          <ContactForm client:load />
        </div>
      </div>

      {/* Info & Social Column */}
      <div class="lg:col-span-5 space-y-12">
        {/* Social Connect */}
        <SocialLinksSection client:load />

        {/* FAQ Section */}
        <div>
          <h2 class="text-2xl font-display font-bold text-[var(--text-primary)] mb-6">
            Frequently Asked Questions
          </h2>
          <FAQAccordion client:idle />
        </div>

        {/* Direct Contact Info */}
        <div
          class="p-6 bg-[var(--bg-surface-raised)] rounded-[var(--radius-lg)] border border-[var(--border-subtle)]"
        >
          <h3 class="font-bold text-[var(--text-primary)] mb-2">Email Us Directly</h3>
          <p class="text-[var(--text-secondary)] mb-4">Prefer email? You can reach us at:</p>
          <a
            href={`mailto:${bloggerProfile.email}`}
            class="text-[var(--color-primary)] font-bold hover:underline"
          >
            {bloggerProfile.email}
          </a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
