---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ContactForm } from '../components/ContactForm';
import { FAQAccordion } from '../components/FAQAccordion';

const title = 'Contact Us | Philippines Travel Blog';
const description =
  'Get in touch with us for collaborations, questions, or just to say hello. We love hearing from fellow travelers!';
const heroImage = '/images/placeholders/people/people-1.jpg';

// Social links data
const socialLinks = [
  { name: 'Instagram', icon: 'instagram', url: 'https://instagram.com', color: 'bg-pink-600' },
  { name: 'Twitter', icon: 'twitter', url: 'https://twitter.com', color: 'bg-blue-400' },
  { name: 'Facebook', icon: 'facebook', url: 'https://facebook.com', color: 'bg-blue-700' },
  { name: 'Pinterest', icon: 'pinterest', url: 'https://pinterest.com', color: 'bg-red-600' },
];
---

<BaseLayout title={title} description={description}>
  {/* Hero Section */}
  <section class="relative h-[40vh] min-h-[400px] flex items-center justify-center overflow-hidden">
    <div class="absolute inset-0 z-0">
      <img src={heroImage} alt="Contact Us" class="w-full h-full object-cover" />
      <div
        class="absolute inset-0 bg-gradient-to-t from-[var(--bg-default)] via-black/40 to-black/20"
      >
      </div>
    </div>
    <div class="relative z-10 text-center px-4 max-w-4xl mx-auto">
      <h1
        class="text-4xl md:text-5xl lg:text-6xl font-display font-bold text-white mb-6 drop-shadow-lg"
      >
        Get in Touch
      </h1>
      <p
        class="text-lg md:text-xl text-white/90 max-w-2xl mx-auto font-light leading-relaxed drop-shadow-md"
      >
        Have a question about a destination? Want to work together? Or just want to share your own
        travel story? We'd love to hear from you.
      </p>
    </div>
  </section>

  <div class="container mx-auto px-4 py-12 md:py-20">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16">
      {/* Contact Form Column */}
      <div class="lg:col-span-7">
        <h2 class="text-3xl font-display font-bold text-[var(--text-primary)] mb-8">
          Send us a Message
        </h2>
        <div
          class="bg-[var(--bg-surface)] rounded-[var(--radius-xl)] p-6 md:p-8 shadow-sm border border-[var(--border-subtle)]"
        >
          <ContactForm client:load />
        </div>
      </div>

      {/* Info & Social Column */}
      <div class="lg:col-span-5 space-y-12">
        {/* Social Connect */}
        <div>
          <h2 class="text-2xl font-display font-bold text-[var(--text-primary)] mb-6">
            Connect with Us
          </h2>
          <p class="text-[var(--text-secondary)] mb-6">
            Follow our adventures in real-time on social media. We post daily updates, stories, and
            travel tips.
          </p>
          <div class="grid grid-cols-2 gap-4">
            {
              socialLinks.map((social) => (
                <a
                  href={social.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class={`flex items-center gap-3 p-4 rounded-[var(--radius-lg)] text-white hover:opacity-90 transition-opacity shadow-md demo-link ${social.color}`}
                >
                  <span class="font-bold">{social.name}</span>
                </a>
              ))
            }
          </div>
          {
            /* Note: The Footer component handles demo link interception globally usually, 
              but we might need to ensure it works here too. 
              The DemoLinkModal logic typically attaches to document or specific elements. 
              Let's ensure the class 'demo-link' is picked up if implemented that way.
              Actually, the modal logic often uses event delegation.
          */
          }
        </div>

        {/* FAQ Section */}
        <div>
          <h2 class="text-2xl font-display font-bold text-[var(--text-primary)] mb-6">
            Frequently Asked Questions
          </h2>
          <FAQAccordion client:idle />
        </div>

        {/* Direct Contact Info */}
        <div
          class="p-6 bg-[var(--bg-surface-raised)] rounded-[var(--radius-lg)] border border-[var(--border-subtle)]"
        >
          <h3 class="font-bold text-[var(--text-primary)] mb-2">Email Us Directly</h3>
          <p class="text-[var(--text-secondary)] mb-4">Prefer email? You can reach us at:</p>
          <a
            href="mailto:hello@travelblog-template.com"
            class="text-[var(--color-primary)] font-bold hover:underline"
          >
            hello@travelblog-template.com
          </a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  import { openDemoModal } from '../store/demo-modal';

  // Handle demo links for social media
  document.querySelectorAll('a.demo-link').forEach((link) => {
    link.addEventListener('click', (e) => {
      e.preventDefault();
      const target = e.currentTarget as HTMLAnchorElement;
      openDemoModal({
        url: target.href,
        label: target.textContent?.trim() || 'Social Link',
        category: 'social',
      });
    });
  });
</script>
