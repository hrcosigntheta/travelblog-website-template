---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ReadingProgress from '../../components/ReadingProgress';
import { ShareButtons } from '../../components/ShareButtons';
import Breadcrumb from '../../components/Breadcrumb.astro';
import type { ImageMetadata } from 'astro';
import { adventures } from '../../data/adventures';
import type { Adventure } from '../../data/adventures/types';
import { ROUTES } from '../../config/paths';
import { Image } from 'astro:assets';

export async function getStaticPaths() {
  return adventures.map((adventure) => ({
    params: { slug: adventure.slug },
    props: { adventure },
  }));
}

interface Props {
  adventure: Adventure;
}

const { adventure } = Astro.props;

const pageTitle = `${adventure.title} | Philippines Travel Blog`;
const pageDescription = adventure.excerpt;

// Dynamically import images
const images = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/images/**/*.{jpeg,jpg,png,webp,avif}'
);
const imagePath = `/src/assets${adventure.image}`;
const imageLoader = images[imagePath];

// Schema for blog post
const schema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: adventure.title,
  description: adventure.excerpt,
  image: Astro.site ? new URL(adventure.image, Astro.site).toString() : adventure.image,
  datePublished: adventure.date,
  author: {
    '@type': 'Person',
    name: adventure.author?.name || 'MasuRii',
  },
});
---

<BaseLayout title={pageTitle} description={pageDescription} schema={schema} ogType="article">
  <div class="container mx-auto px-4 pt-4">
    <Breadcrumb
      items={[
        { label: 'Blog', href: ROUTES.BLOG },
        { label: adventure.title, href: ROUTES.BLOG_DETAIL(adventure.slug) },
      ]}
    />
  </div>

  <ReadingProgress client:idle />

  <article class="py-12">
    <header class="container mx-auto px-4 max-w-4xl text-center mb-12">
      <div class="flex items-center justify-center gap-4 mb-4 text-[var(--text-muted)] font-medium">
        <time datetime={adventure.date}>
          {
            new Date(adventure.date).toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            })
          }
        </time>
        <span>•</span>
        <span>{adventure.readTime} min read</span>
      </div>

      <h1 class="text-4xl md:text-6xl font-bold text-[var(--text-primary)] mb-8">
        {adventure.title}
      </h1>

      <div class="rounded-3xl overflow-hidden aspect-[21/9] shadow-xl">
        {
          imageLoader ? (
            <Image
              src={(await imageLoader()).default}
              alt={adventure.imageAlt}
              class="w-full h-full object-cover"
            />
          ) : (
            <img
              src={adventure.image}
              alt={adventure.imageAlt}
              class="w-full h-full object-cover"
            />
          )
        }
      </div>
    </header>

    <div class="container mx-auto px-4 max-w-3xl">
      <div class="prose prose-lg dark:prose-invert max-w-none text-[var(--text-secondary)]">
        <div set:html={adventure.content} />
      </div>

      <footer class="mt-16 pt-8 border-t border-[var(--border-subtle)]">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-8">
          <div class="flex items-center gap-4">
            {
              adventure.author?.image && (
                <img
                  src={adventure.author.image}
                  alt={adventure.author.name}
                  class="w-12 h-12 rounded-full object-cover"
                />
              )
            }
            <div>
              <span
                class="block text-sm text-[var(--text-muted)] uppercase tracking-wider font-bold"
                >Written by</span
              >
              <span class="text-[var(--text-primary)] font-bold"
                >{adventure.author?.name || 'MasuRii'}</span
              >
            </div>
          </div>

          <ShareButtons
            client:visible
            title={adventure.title}
            description={adventure.excerpt}
            image={adventure.image}
          />
        </div>

        <div class="mt-12 flex flex-wrap gap-2">
          {
            adventure.categories.map((category) => (
              <span class="px-4 py-1.5 bg-[var(--bg-surface-raised)] border border-[var(--border-subtle)] rounded-full text-sm font-medium text-[var(--text-secondary)]">
                {category}
              </span>
            ))
          }
        </div>
      </footer>
    </div>
  </article>
</BaseLayout>
