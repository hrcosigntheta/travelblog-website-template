---
import BaseLayout from '../layouts/BaseLayout.astro';
import { destinations } from '../data/destinations';
import { ImageWithFallback } from '../components/ImageWithFallback';
import { ROUTES } from '../config/paths';

// Filter destinations that have itineraries
const itineraryDestinations = destinations.filter(
  (dest) => dest.itinerary && dest.itinerary.length > 0
);

const title = 'Travel Itineraries | Philippines Travel Blog';
const description = 'Curated travel itineraries for the best destinations in the Philippines.';
---

<BaseLayout title={title} description={description}>
  <div class="container mx-auto px-4 py-12">
    <div class="text-center mb-12">
      <h1 class="text-4xl md:text-5xl font-bold text-[var(--color-text-primary)] mb-4">
        Travel Itineraries
      </h1>
      <p class="text-xl text-[var(--color-text-secondary)] max-w-2xl mx-auto">
        Plan your perfect trip with our detailed day-by-day guides.
      </p>
    </div>

    {
      itineraryDestinations.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {itineraryDestinations.map((dest) => (
            <a
              href={`${ROUTES.DESTINATION_DETAIL(dest.slug)}#itinerary`}
              class="group block bg-[var(--color-surface)] rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 border border-[var(--color-border)] hover:-translate-y-1"
            >
              <div class="relative h-56 overflow-hidden">
                <ImageWithFallback
                  src={dest.image}
                  alt={dest.title}
                  className="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                  client:visible
                />
                <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/80 to-transparent p-4">
                  <span class="inline-block px-3 py-1 bg-[var(--color-primary)] text-white text-xs font-bold rounded-full mb-2">
                    {dest.itinerary?.length} Days
                  </span>
                </div>
              </div>

              <div class="p-6">
                <div class="flex items-center justify-between mb-2">
                  <span class="text-sm font-medium text-[var(--color-primary)]">{dest.region}</span>
                  <span class="text-sm text-[var(--color-text-secondary)] flex items-center gap-1">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <circle cx="12" cy="12" r="10" />
                      <polyline points="12 6 12 12 16 14" />
                    </svg>
                    <span>
                      {dest.itinerary?.reduce((acc, day) => acc + day.activities.length, 0)}{' '}
                      Activities
                    </span>
                  </span>
                </div>

                <h2 class="text-xl font-bold text-[var(--color-text-primary)] mb-2 group-hover:text-[var(--color-primary)] transition-colors">
                  {dest.title}
                </h2>

                <p class="text-[var(--color-text-secondary)] line-clamp-2 text-sm">
                  {dest.description}
                </p>

                <div class="mt-4 pt-4 border-t border-[var(--color-border)] flex items-center text-[var(--color-primary)] text-sm font-medium">
                  View Itinerary
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="ml-1 transition-transform group-hover:translate-x-1"
                  >
                    <line x1="5" y1="12" x2="19" y2="12" />
                    <polyline points="12 5 19 12 12 19" />
                  </svg>
                </div>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <div class="text-center py-20 bg-[var(--color-surface)] rounded-3xl border border-dashed border-[var(--color-border)]">
          <div class="bg-[var(--color-surface-elevated)] w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="32"
              height="32"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="text-[var(--color-text-muted)]"
            >
              <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z" />
              <polyline points="14 2 14 8 20 8" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-[var(--color-text-primary)] mb-2">
            No Itineraries Yet
          </h3>
          <p class="text-[var(--color-text-secondary)]">
            We're busy curating the best travel plans for you. Check back soon!
          </p>
        </div>
      )
    }
  </div>
</BaseLayout>
