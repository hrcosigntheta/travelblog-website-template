---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Privacy Policy | Philippines Travel Blog">
  <div class="container mx-auto px-4 py-20 max-w-4xl">
    <h1 class="text-4xl font-bold mb-8">Privacy Policy</h1>
    <div class="prose dark:prose-invert max-w-none">
      <p>
        This is a template privacy policy. In a production site, you would include details about how
        you collect and use data.
      </p>
      <h2>Data Collection</h2>
      <p>We do not collect personal data on this demo site.</p>
      <h2>Cookies</h2>
      <p>We use local storage to persist your theme preference (light or dark mode).</p>
    </div>
  </div>
</BaseLayout>
