---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Terms of Service | Philippines Travel Blog">
  <div class="container mx-auto px-4 py-20 max-w-4xl">
    <h1 class="text-4xl font-bold mb-8">Terms of Service</h1>
    <div class="prose dark:prose-invert max-w-none">
      <p>
        This is a template Terms of Service. In a production site, you would include details about
        the rules and regulations for using your website.
      </p>
      <h2>Usage</h2>
      <p>This site is for demonstration purposes only.</p>
      <h2>Content</h2>
      <p>All content is placeholder content meant to showcase the template's features.</p>
    </div>
  </div>
</BaseLayout>
