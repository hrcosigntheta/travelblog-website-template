---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DestinationHero from '../../components/DestinationHero.astro';
import ItineraryTimeline from '../../components/ItineraryTimeline';
import LazyMap from '../../components/LazyMap';
import PracticalInfo from '../../components/PracticalInfo';
import { PhotoGallery } from '../../components/PhotoGallery';
import { destinations } from '../../data/destinations';
import type { Destination, ItineraryActivityData } from '../../data/destinations';
import { RelatedDestinations } from '../../components/RelatedDestinations';
import { ShareButtons } from '../../components/ShareButtons';
import ReadingProgress from '../../components/ReadingProgress';

export async function getStaticPaths() {
  return destinations.map((destination) => ({
    params: { slug: destination.slug },
    props: { destination },
  }));
}

interface Props {
  destination: Destination;
}

const { destination } = Astro.props;

// Helper to map icon types to React Nodes (simple SVGs for now)
const getIcon = (type?: string) => {
  // We can return simple emoji or SVG strings for now as placeholders
  // In a real app, these would be proper SVG components
  switch (type) {
    case 'transport':
      return '✈️';
    case 'food':
      return '🍽️';
    case 'activity':
      return '🏄';
    case 'nature':
      return '🌴';
    case 'relax':
      return '🍹';
    default:
      return '📍';
  }
};

// Transform itinerary data for the component
const itineraryDays =
  destination.itinerary?.map((day) => ({
    title: day.title,
    activities: day.activities.map((activity: ItineraryActivityData) => ({
      ...activity,
      icon: getIcon(activity.iconType),
    })),
  })) || [];

// Transform images for the gallery
const galleryImages =
  destination.images?.map((src) => ({
    src,
    alt: destination.title,
    caption: destination.title, // We could add specific captions if data supported it
  })) || [];

// Logic to find related destinations
// 1. Same region
// 2. Fallback to others if not enough
let relatedDestinations = destinations.filter(
  (d) => d.id !== destination.id && d.region === destination.region
);

if (relatedDestinations.length < 3) {
  const others = destinations.filter(
    (d) => d.id !== destination.id && d.region !== destination.region
  );
  // Simple shuffle or just take next available
  relatedDestinations = [...relatedDestinations, ...others].slice(0, 3);
}

const pageTitle = `${destination.title} | Philippines Travel Blog`;
const pageDescription = destination.description;

import { generateDestinationSchema } from '../../utils/schema';
const schema = JSON.stringify(generateDestinationSchema(destination, Astro.url));
---

<BaseLayout title={pageTitle} description={pageDescription} schema={schema}>
  <ReadingProgress client:idle />
  <DestinationHero destination={destination} />

  <main class="container mx-auto px-4 py-16 space-y-20">
    {/* Quick Stats & Highlights */}
    <section class="grid grid-cols-1 lg:grid-cols-3 gap-12">
      <div class="lg:col-span-2 space-y-8">
        <h2 class="text-3xl font-bold text-[var(--text-primary)]">About {destination.title}</h2>
        <div
          class="prose dark:prose-invert max-w-none text-lg text-[var(--text-secondary)]"
          set:html={destination.content}
        />

        {
          destination.highlights && (
            <div class="mt-8">
              <h3 class="text-xl font-bold mb-4">Highlights</h3>
              <ul class="grid grid-cols-1 md:grid-cols-2 gap-3">
                {destination.highlights.map((highlight) => (
                  <li class="flex items-center gap-3 text-[var(--text-secondary)]">
                    <span class="text-[var(--color-primary)]">✓</span>
                    {highlight}
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </div>

      <div class="lg:col-span-1">
        <div class="sticky top-24 space-y-8">
          <div
            class="bg-[var(--bg-card)] border border-[var(--border-subtle)] rounded-[var(--radius-lg)] p-6 shadow-sm"
          >
            <h3 class="text-xl font-bold mb-6">Trip Essentials</h3>
            <div class="space-y-6">
              <div class="flex items-start gap-4">
                <div
                  class="p-2 bg-blue-100 dark:bg-blue-900/30 rounded-full text-blue-600 dark:text-blue-400"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    ><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"
                    ></polyline></svg
                  >
                </div>
                <div>
                  <span
                    class="block text-sm font-bold text-[var(--text-secondary)] uppercase tracking-wide"
                    >Best Time</span
                  >
                  <span class="text-[var(--text-primary)] font-medium"
                    >{destination.stats.bestTime}</span
                  >
                </div>
              </div>

              <div class="flex items-start gap-4">
                <div
                  class="p-2 bg-green-100 dark:bg-green-900/30 rounded-full text-green-600 dark:text-green-400"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    ><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"
                    ></path></svg
                  >
                </div>
                <div>
                  <span
                    class="block text-sm font-bold text-[var(--text-secondary)] uppercase tracking-wide"
                    >Budget</span
                  >
                  <span class="text-[var(--text-primary)] font-medium"
                    >{destination.stats.budget}</span
                  >
                </div>
              </div>

              <div class="flex items-start gap-4">
                <div
                  class="p-2 bg-orange-100 dark:bg-orange-900/30 rounded-full text-orange-600 dark:text-orange-400"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    ><path d="M6.5 6.5l11 11M21 21l-1-1M3 3l1 1M21 3l-1 1M3 21l1-1M17 7v10M7 7v10"
                    ></path></svg
                  >
                </div>
                <div>
                  <span
                    class="block text-sm font-bold text-[var(--text-secondary)] uppercase tracking-wide"
                    >Difficulty</span
                  >
                  <span class="text-[var(--text-primary)] font-medium"
                    >{destination.stats.difficulty}</span
                  >
                </div>
              </div>

              <div class="pt-6 border-t border-[var(--border-subtle)]">
                <div class="flex flex-wrap gap-2">
                  {
                    destination.tags.map((tag) => (
                      <span class="px-3 py-1 bg-[var(--bg-surface-raised)] border border-[var(--border-subtle)] rounded-full text-sm text-[var(--text-secondary)]">
                        {tag}
                      </span>
                    ))
                  }
                </div>
              </div>
            </div>
          </div>
          <RelatedDestinations client:load destinations={relatedDestinations} />

          <div
            class="bg-[var(--bg-card)] border border-[var(--border-subtle)] rounded-[var(--radius-lg)] p-6 shadow-sm"
          >
            <ShareButtons
              client:load
              title={destination.title}
              description={destination.description}
              image={destination.images?.[0]}
            />
          </div>
        </div>
      </div>
    </section>

    {/* Photo Gallery */}
    {
      galleryImages.length > 0 && (
        <section>
          <div class="flex items-center justify-between mb-8">
            <h2 class="text-3xl font-bold text-center w-full relative">
              Photo Gallery
              <span class="absolute right-0 top-1/2 -translate-y-1/2 text-lg font-normal text-[var(--text-muted)] hidden md:inline-block">
                {galleryImages.length} Photos
              </span>
            </h2>
          </div>
          <PhotoGallery client:visible images={galleryImages} />
        </section>
      )
    }

    {/* Itinerary */}
    {
      itineraryDays.length > 0 && (
        <section id="itinerary" class="scroll-mt-24">
          {/* Print Header - Fixed on every page when printing */}
          <div class="hidden print:block fixed top-0 left-0 w-full text-center border-b border-gray-300 pb-4 mb-8 bg-white z-50">
            <h1 class="text-2xl font-bold text-black">{destination.title} Itinerary</h1>
            <p class="text-sm text-gray-600 mt-1">Suggested Travel Plan</p>
          </div>

          <div class="flex items-center justify-center gap-4 mb-8 relative">
            <h2 class="text-3xl font-bold text-center">Suggested Itinerary</h2>
            <button
              id="print-itinerary-btn"
              class="hidden md:inline-flex items-center gap-2 px-4 py-2 bg-[var(--bg-surface)] border border-[var(--border-subtle)] rounded-full text-sm font-medium hover:bg-[var(--bg-surface-raised)] hover:border-[var(--color-primary)] transition-colors text-[var(--text-secondary)] hover:text-[var(--color-primary)] print:hidden absolute right-0 top-1/2 -translate-y-1/2"
              aria-label="Print Itinerary"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="6 9 6 2 18 2 18 9" />
                <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2" />
                <rect x="6" y="14" width="12" height="8" />
              </svg>
              Print
            </button>
          </div>
          <div class="max-w-4xl mx-auto print:mt-24">
            <ItineraryTimeline client:visible days={itineraryDays} />
          </div>
        </section>
      )
    }

    {/* Map */}
    <section>
      <h2 class="text-3xl font-bold mb-8 text-center">Location</h2>
      <div
        class="h-[500px] rounded-[var(--radius-lg)] overflow-hidden shadow-md border border-[var(--border-subtle)]"
      >
        <LazyMap
          client:only="react"
          destinations={[destination]}
          center={[destination.coordinates.lat, destination.coordinates.lng]}
          zoom={12}
          className="h-full w-full"
        />
      </div>
    </section>

    {/* Practical Info */}
    {destination.practicalInfo && <PracticalInfo client:visible info={destination.practicalInfo} />}
  </main>
</BaseLayout>

<script>
  const printBtn = document.getElementById('print-itinerary-btn');
  if (printBtn) {
    printBtn.addEventListener('click', () => {
      window.print();
    });
  }
</script>
