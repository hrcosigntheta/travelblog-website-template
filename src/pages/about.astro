---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ImageWithFallback } from '../components/ImageWithFallback';
import { BloggerHero } from '../components/BloggerHero';
import { TravelPhilosophy } from '../components/TravelPhilosophy';
import { TravelStats } from '../components/TravelStats';

import { EquipmentShowcase } from '../components/EquipmentShowcase';
import { TravelTimeline } from '../components/TravelTimeline';

import Breadcrumb from '../components/Breadcrumb.astro';

import { bloggerProfile } from '../data/blogger';
import { generatePersonSchema } from '../utils/schema';

const title = `${bloggerProfile.name} | Philippine Travel Blog`;
const description = bloggerProfile.shortBio;

const schema = JSON.stringify(generatePersonSchema(bloggerProfile, Astro.site!));

const stats = [
  { label: 'Islands Visited', value: '45+' },
  { label: 'Years Traveling', value: '7' },
  { label: 'Provinces Explored', value: '32' },
  { label: 'Photo Stories', value: '500+' },
];

const travelStats = bloggerProfile.travelStats;
const milestones = bloggerProfile.milestones;
const socialLinks = bloggerProfile.socialLinks;
const equipmentItems = bloggerProfile.equipment;
---

<BaseLayout title={title} description={description} schema={schema}>
  <div class="container mx-auto px-4 pt-4">
    <Breadcrumb items={[{ label: 'About', href: '/about' }]} />
  </div>
  {/* Hero Section */}
  <section class="relative h-[60vh] min-h-[400px] flex items-center justify-center overflow-hidden">
    <div class="absolute inset-0 z-0">
      <ImageWithFallback
        src={bloggerProfile.heroSrc}
        alt="Travel blogger looking at a landscape"
        className="w-full h-full object-cover"
        loading="eager"
        client:load
      />
      <div
        class="absolute inset-0 bg-gradient-to-b from-black/30 via-black/20 to-[var(--color-surface)]"
      >
      </div>
    </div>
    <div class="container mx-auto px-4 relative z-10 text-center">
      <h1 class="text-4xl md:text-6xl font-bold text-white mb-6 drop-shadow-lg">
        Exploring the Pearl of the Orient
      </h1>
      <p class="text-xl md:text-2xl text-white/90 max-w-2xl mx-auto drop-shadow-md">
        Sharing stories, guides, and inspiration from 7,641 islands.
      </p>
    </div>
  </section>

  {/* Bio Section */}
  <BloggerHero
    name={bloggerProfile.name}
    tagline={bloggerProfile.tagline}
    portraitSrc={bloggerProfile.portraitSrc}
    stats={stats}
    socialLinks={socialLinks}
    client:visible
  >
    {bloggerProfile.fullBio.map((paragraph) => <p class="mb-4">{paragraph}</p>)}
  </BloggerHero>

  {/* Philosophy Section */}
  <TravelPhilosophy
    quote={bloggerProfile.philosophy.quote}
    content={bloggerProfile.philosophy.content}
    missionStatement={bloggerProfile.philosophy.missionStatement}
    client:visible
  />

  {/* Travel Stats Section */}
  <TravelStats stats={travelStats} client:visible />

  {/* Travel Timeline Section */}
  <TravelTimeline milestones={milestones} client:visible />

  {/* Gear Section */}
  <EquipmentShowcase items={equipmentItems} client:visible />
</BaseLayout>
